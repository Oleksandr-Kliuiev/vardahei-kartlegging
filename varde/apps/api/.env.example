# Environment of @varde/api (the only .env example of the api). Names only: values live in
# /etc/varde/app.env on the VPS.
# PostgreSQL URL without connection_limit (PrismaService adds it from config/db-budget.json).
# On the VPS the file with credentials is /etc/varde/app.env (0600 root), written by
# infra/sql/bootstrap.sh; its holders are listed in the 0b evidence.
DATABASE_URL=
# Directory with db-budget.json and other config; default varde/config, /out/config in the image.
VARDE_CONFIG_DIR=
PORT=3000
# Image tag (commit sha), set by infra/Dockerfile (ARG VARDE_VERSION); GET /health returns it.
VARDE_VERSION=
# Entra login (0.7): certificate (private_key_jwt), no client secret. IDs from /etc/varde/entra.env.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# PEM files mounted read-only from /etc/varde/entra/ (key.pem, cert.pem).
ENTRA_CLIENT_KEY_FILE=
ENTRA_CLIENT_CERT_FILE=
# Object id of the group "Varde admins".
VARDE_ADMIN_GROUP_ID=
# Signs the cookies varde_session and varde_oidc; written once by infra/sql/bootstrap.sh.
SESSION_SECRET=
# Absolute session lifetime in seconds (28800 = 8 h when empty).
SESSION_TTL_SECONDS=
# Public origin, e.g. the Varde host; redirect URI = PUBLIC_URL + /auth/callback.
PUBLIC_URL=
# Tests and e2e only: issuer of the mock OIDC server instead of login.microsoftonline.com.
VARDE_OIDC_ISSUER=
# Break-glass (0.8), off unless both UNTIL (ISO time, ≤ BREAK_GLASS_MAX_HOURS ahead) and the
# argon2id hash are set. The hash line comes from `node dist/cli.js break-glass-hash` and MUST
# stay in single quotes in app.env (Compose interpolates $ otherwise).
VARDE_BREAK_GLASS_UNTIL=
VARDE_BREAK_GLASS_PASSWORD_HASH=
# Which SSH holder enabled it; AuditLog who = break-glass:<name>.
VARDE_BREAK_GLASS_OPERATOR=
VARDE_BREAK_GLASS_SOCKET=/run/varde/break-glass.sock
# Longest allowed window in hours (4 when empty).
BREAK_GLASS_MAX_HOURS=

# Built respondent app (self-hosted assets).
VARDE_STATIC_DIR=
