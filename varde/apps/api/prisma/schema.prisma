// Varde database schema (stage 0: AuditLog only). Migrations: prisma/migrations (see CLAUDE.md).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Who did what, when, to which target (ARCHITECTURE §4, ADR-025).
/// `details` holds the release volume (round, client, count) — never secrets, never respondent
/// answers and never `respondent_key` (test in 0.15).
model AuditLog {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  at      DateTime @default(now()) @db.Timestamptz(6)
  who     String
  what    String
  target  String?
  details Json?    @db.JsonB

  @@index([at])
  @@index([what, at])
  @@map("audit_log")
}

/// Server-side admin session (0.7, ADR-008). The cookie `varde_session` carries only the signed
/// `sid`. `via` ∈ {entra, break_glass} (CHECK in the migration); no respondent data.
model AdminSession {
  sid        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  oid        String?
  name       String?
  via        String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)

  @@index([expires_at])
  @@map("admin_session")
}

/// Load stand of 0.12 only (ADR-016): synthetic submissions written like the future Submission
/// API (1.16). Removed together with modules/stub by a migration in 1.33.
model StubSubmission {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_id String   @unique @db.Uuid
  answers       Json     @db.JsonB
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@map("stub_submission")
}
