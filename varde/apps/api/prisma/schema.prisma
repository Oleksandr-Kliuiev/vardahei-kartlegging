// Varde database schema (stage 0: AuditLog only). Migrations: prisma/migrations (see CLAUDE.md).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Who did what, when, to which target (ARCHITECTURE §4, ADR-025).
/// `details` holds the release volume (round, client, count) — never secrets, never respondent
/// answers and never `respondent_key` (test in 0.15).
model AuditLog {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  at      DateTime @default(now()) @db.Timestamptz(6)
  who     String
  what    String
  target  String?
  details Json?    @db.JsonB

  @@index([at])
  @@index([what, at])
  @@map("audit_log")
}

/// Server-side admin session (0.7, ADR-008). The cookie `varde_session` carries only the signed
/// `sid`. `via` ∈ {entra, break_glass} (CHECK in the migration); no respondent data.
model AdminSession {
  sid        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  oid        String?
  name       String?
  via        String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)

  @@index([expires_at])
  @@map("admin_session")
}

/// Survey template (1.4a, ARCHITECTURE §4): one per questionnaire; versions carry the content.
/// `audience` ∈ {client_survey, seminar_live, seminar_after} (CHECK in the migration).
model SurveyTemplate {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String            @unique
  audience           String
  required_languages String[]
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  versions           TemplateVersion[]
  comments           QuestionComment[]

  @@map("survey_template")
}

/// Version of a template (1.4a, ADR-005, ADR-019, ADR-025). A published version is immutable:
/// trigger `template_version_immutable` rejects UPDATE and DELETE once `status = published`.
/// `status` ∈ {draft, published}, `identification` ∈ {initials, none},
/// `origin` ∈ {authored, kartlegging, external_import} (CHECKs in the migration).
model TemplateVersion {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id            String            @db.Uuid
  template               SurveyTemplate    @relation(fields: [template_id], references: [id], onDelete: Restrict)
  rounds                 Round[]
  label                  String
  version_no             Int
  status                 String            @default("draft")
  identification         String            @default("initials")
  required_languages     String[]
  content                Json              @db.JsonB
  translation_acceptance Json              @default("{}") @db.JsonB
  origin                 String
  content_hash           String
  created_at             DateTime          @default(now()) @db.Timestamptz(6)
  published_at           DateTime?         @db.Timestamptz(6)
  published_by           String?
  /// Marks of changed frozen questions at publication: [{id, kind: orthographic|semantic}] (ADR-005).
  frozen_changes         Json?             @db.JsonB
  /// What each language was approved on (2.16): {lang: {at, by, texts: {key: words}}} — the texts of that
  /// language (and their Nynorsk source) at the last approval, so the workshop can say what changed
  /// since. Kept when the draft is saved (the approval itself is not, ADR-019); empty in a new draft.
  acceptance_basis       Json              @default("{}") @db.JsonB
  comments               QuestionComment[]

  @@unique([template_id, version_no])
  @@unique([template_id, label])
  @@map("template_version")
}

/// A note on a question or a part of a survey (2.18), written and read by admins in the workshop.
/// Kept per survey, so it follows the next draft; `template_version_id` is the version it was written
/// on. `node` is a question id or a part (`:velkomen`, `:slutt` …). Never shown to respondents.
model QuestionComment {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id         String          @db.Uuid
  template            SurveyTemplate  @relation(fields: [template_id], references: [id], onDelete: Cascade)
  template_version_id String          @db.Uuid
  template_version    TemplateVersion @relation(fields: [template_version_id], references: [id], onDelete: Cascade)
  node                String
  text                String
  created_by          String
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  resolved_at         DateTime?       @db.Timestamptz(6)
  resolved_by         String?

  @@index([template_id])
  @@map("question_comment")
}

/// Settings of the admin (2.16, decision 6 of 17.10), by key: `defaults` holds the contact, sender
/// and opening hours that new surveys take. Every change is written to AuditLog (`settings.update`).
model AppSetting {
  key        String   @id
  value      Json     @db.JsonB
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  updated_by String

  @@map("app_setting")
}

/// Client (1.4b, ARCHITECTURE §4): mirror of Atlas; in stage 1 filled from kundar.json (1.7).
/// `kind` ∈ {client, seminar} (CHECK): `seminar` is the one technical client of seminar live polls
/// (3.4): a live round has one RoundClient for the whole seminar (ADR-022), never split by company,
/// and `round_client.client_id` stays NOT NULL. At most one (partial unique index); a RoundClient
/// has it exactly when its round is `live` (trigger round_client_live); hidden from client lists.
model Client {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String          @unique
  name              String
  kind              String          @default("client")
  industry          String?
  employee_count    Int?
  default_lang      String          @default("nn")
  atlas_external_id String?
  round_clients     RoundClient[]
  seminars          SeminarClient[]
  contacts          Contact[]

  @@map("client")
}

/// Round (1.4b, ADR-022, ADR-025). `template_version_id` and `identification` are fixed when the
/// round leaves `draft` (CHECK round_mode_fixed, trigger round_freeze).
/// `type` ∈ {regular, post_seminar, live, external_import}; `status` ∈ {draft, open, closed, archived}.
model Round {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  type                String
  template_version_id String?            @db.Uuid
  template_version    TemplateVersion?   @relation(fields: [template_version_id], references: [id], onDelete: Restrict)
  identification      String?
  status              String             @default("draft")
  created_at          DateTime           @default(now()) @db.Timestamptz(6)
  opened_at           DateTime?          @db.Timestamptz(6)
  closed_at           DateTime?          @db.Timestamptz(6)
  round_clients       RoundClient[]
  seminars_before     Seminar[]          @relation("seminar_round_before")
  seminars_live       Seminar[]          @relation("seminar_round_live")
  seminars_after      Seminar[]          @relation("seminar_round_after")
  live_questions      LivePollQuestion[]

  @@map("round")
}

/// One client in one round (1.4b, ADR-022, ADR-009): code, snapshot of the population, deadline,
/// lifecycle `draft → open → closed → archived`. `legacy_code_hash` = sha256 of the kartlegging code.
model RoundClient {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id            String             @db.Uuid
  round               Round              @relation(fields: [round_id], references: [id], onDelete: Restrict)
  client_id           String             @db.Uuid
  client              Client             @relation(fields: [client_id], references: [id], onDelete: Restrict)
  code                String?
  code_hash           String?            @unique
  code_expires_at     DateTime?          @db.Timestamptz(6)
  code_revoked_at     DateTime?          @db.Timestamptz(6)
  legacy_code_hash    String?
  population_snapshot Int?
  deadline            DateTime?          @db.Date
  status              String             @default("draft")
  /// Sent by hand (2.18): Varde sends nothing, so the admin marks what went out and when; the last
  /// reminder counts. Each mark is in AuditLog (`rounds.client.sent`).
  invitation_sent_at  DateTime?          @db.Timestamptz(6)
  invitation_sent_by  String?
  reminder_sent_at    DateTime?          @db.Timestamptz(6)
  reminder_sent_by    String?
  report_sent_at      DateTime?          @db.Timestamptz(6)
  report_sent_by      String?
  responses           Response[]
  progress_events     ProgressEvent[]
  revoked_codes       RevokedRoundCode[]

  @@unique([round_id, client_id])
  @@map("round_client")
}

/// Hash-only history: old links retain the revoked message after reissue (ADR-009).
model RevokedRoundCode {
  code_hash       String      @id
  round_client_id String      @db.Uuid
  round_client    RoundClient @relation(fields: [round_client_id], references: [id], onDelete: Cascade)
  revoked_at      DateTime    @default(now()) @db.Timestamptz(6)

  @@map("revoked_round_code")
}

/// One part (common | leader) of one submission (1.4b, ADR-006, ADR-024, ADR-025). No names, IP
/// or exact time; `respondent_key` only in rounds with identification = initials (trigger
/// response_respondent_key_mode); the only FK is round_client. (source_id, part) is unique for
/// imported rows (NULLs are distinct in Postgres, so live submissions are not constrained).
model Response {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_client_id String      @db.Uuid
  round_client    RoundClient @relation(fields: [round_client_id], references: [id], onDelete: Restrict)
  part            String
  role            String?
  lang            String
  respondent_key  String?
  answers         Json        @db.JsonB
  free            Json        @default("{}") @db.JsonB
  submission_id   String      @unique @db.Uuid
  content_hash    String
  source_id       String?
  duration_s      Int?
  submitted_day   DateTime    @db.Date

  @@unique([source_id, part])
  @@index([round_client_id, part])
  @@map("response")
}

/// Anonymous progress of a runner session (1.4b; TTL 24 h, ADR-021): no link to Response.
model ProgressEvent {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_client_id String      @db.Uuid
  round_client    RoundClient @relation(fields: [round_client_id], references: [id], onDelete: Restrict)
  session_id      String
  question_no     Int
  finished        Boolean     @default(false)
  at              DateTime    @default(now()) @db.Timestamptz(6)

  @@index([round_client_id, at])
  @@map("progress_event")
}

/// Versioned measurement contract (1.4c, ADR-020); `definition` is the MetricDefinition JSON.
model MetricDefinition {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String
  version    Int
  definition Json   @db.JsonB

  @@unique([key, version])
  @@map("metric_definition")
}

/// Released aggregate cell (1.4c, ADR-020, ADR-021). Written only by privacy.release() through
/// modules/privacy/prisma-snapshot-store.ts. A released row may only become `superseded` with a
/// reason (other columns unchanged); released and superseded rows are never deleted (trigger
/// aggregate_snapshot_released). `status` ∈ {computed, released, superseded}.
model AggregateSnapshot {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id          String    @db.Uuid
  population        String
  round_client_id   String?   @db.Uuid
  client_id         String?   @db.Uuid
  metric_key        String
  metric_version    Int
  group             String
  n                 Int
  numerator         Float
  denominator       Float
  missing           Int
  suppressed        Boolean
  stale             Boolean   @default(false)
  status            String
  computed_at       DateTime  @db.Date
  released_at       DateTime? @db.Date
  superseded_at     DateTime? @db.Timestamptz(6)
  superseded_reason String?
  release_id        String    @db.Uuid

  @@index([round_id, population, status])
  @@index([release_id])
  @@map("aggregate_snapshot")
}

/// Metric set of a round, fixed by the first release of any population (1.4c, ADR-021 rule 4).
model RoundMetricSet {
  round_id    String   @id @db.Uuid
  metric_keys String[]
  fixed_at    DateTime @default(now()) @db.Timestamptz(6)

  @@map("round_metric_set")
}

/// FUNN rule (1.4c, ADR-026): `channel` ∈ {aggregate, leader}. A version never changes (trigger
/// finding_rule_immutable); the editor saves a change as version max + 1 (2.5).
model FindingRule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String
  version    Int
  channel    String
  definition Json     @db.JsonB
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([key, version])
  @@map("finding_rule")
}

/// The findings of one release are computed once (2.5): `scope` is `all` or the client id,
/// `rule_keys` (`key@version`) the rules in effect at that moment. A closed round shows the saved
/// findings of its release; a later rule version never recalculates them. Never updated or
/// deleted (trigger finding_set_immutable).
model FindingSet {
  release_id  String   @db.Uuid
  scope       String
  round_id    String   @db.Uuid
  rule_keys   String[]
  computed_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([release_id, scope])
  @@index([round_id])
  @@map("finding_set")
}

/// A finding computed over released snapshots (1.4c; retention as released snapshots): one row
/// per rule and release, written once with its rule version (2.5). Never updated (trigger).
model Finding {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  round_id     String         @db.Uuid
  client_id    String?        @db.Uuid
  rule_key     String
  rule_version Int
  numbers      Json           @db.JsonB
  release_id   String         @db.Uuid
  status       FindingStatus?

  @@index([round_id])
  @@map("finding")
}

/// Provable import (1.4c, ADR-024): counts and rejected line numbers with reasons, never answers
/// or initials. `source` ∈ {svar, runde1}, `status` ∈ {ok, failed}.
model ImportManifest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source      String
  source_hash String
  round_ids   String[]
  counts      Json     @db.JsonB
  rejected    Json     @db.JsonB
  status      String
  started_by  String
  at          DateTime @default(now()) @db.Timestamptz(6)

  @@map("import_manifest")
}

/// Deletion on request (1.4c, ADR-017): `scope` ∈ {client, respondent, submissions, participant}
/// (participant: 3.1, a seminar contact by e-mail; its tombstones are ParticipantTombstone).
model DeletionRequest {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requested_by String
  reason       String
  scope        String
  scope_ref    Json                   @db.JsonB
  at           DateTime               @default(now()) @db.Timestamptz(6)
  tombstones   DeletionTombstone[]
  participants ParticipantTombstone[]

  @@map("deletion_request")
}

/// Tombstone of a deleted Response part: keeps import, restore and rollback from bringing it
/// back (ADR-017, ADR-024). No answers.
model DeletionTombstone {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id     String          @db.Uuid
  request        DeletionRequest @relation(fields: [request_id], references: [id], onDelete: Restrict)
  submission_id  String          @db.Uuid
  content_hash   String
  round_id       String          @db.Uuid
  client_id      String          @db.Uuid
  part           String
  source_id      String?
  respondent_key String?

  @@index([source_id, part])
  @@index([submission_id])
  @@map("deletion_tombstone")
}

/// Seminar (3.1, ARCHITECTURE §4 and §7): topic in nynorsk (and English when `required_languages`
/// has en), start and end as instants (shown in Europe/Oslo), place, `format` ∈ {onsite, digital},
/// the clients it is for and the registration link: `code` is a 128-bit bearer looked up by
/// `code_hash` (ADR-009), replaced by «Ny lenkje» (old hashes in RevokedSeminarCode). `sequence`
/// grows when time, place or topic change (ICS updates). Rounds (3.4, 3.8; triggers and partial unique
/// indexes): live (made with the live poll), before (type regular) and after (type post_seminar), one
/// seminar per live or after round. No personal data: participants are Contact and Registration.
model Seminar {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic_nn           String
  topic_en           String?
  starts_at          DateTime             @db.Timestamptz(6)
  ends_at            DateTime             @db.Timestamptz(6)
  place              String
  format             String
  required_languages String[]
  code               String
  code_hash          String               @unique
  sequence           Int                  @default(0)
  round_before_id    String?              @db.Uuid
  round_before       Round?               @relation("seminar_round_before", fields: [round_before_id], references: [id], onDelete: SetNull)
  round_live_id      String?              @db.Uuid
  round_live         Round?               @relation("seminar_round_live", fields: [round_live_id], references: [id], onDelete: SetNull)
  round_after_id     String?              @db.Uuid
  round_after        Round?               @relation("seminar_round_after", fields: [round_after_id], references: [id], onDelete: SetNull)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  created_by         String
  clients            SeminarClient[]
  registrations      Registration[]
  finding_statuses   FindingStatus[]
  materials          SeminarMaterial[]
  revoked_codes      RevokedSeminarCode[]
  presenter_tokens   PresenterToken[]

  @@index([ends_at])
  @@map("seminar")
}

/// State of one question of a seminar live poll (3.4, ADR-022 `LivePollQuestionState`): `state` ∈
/// {waiting, open, closed, released} (CHECK). The server leads: waiting → open → closed → released;
/// a closed question may open again until it is shown; `released` is final (trigger
/// live_poll_question_step). At most one open question per poll (partial unique index). No answers
/// here: they are Response rows of the live round. Every change is in AuditLog.
model LivePollQuestion {
  round_id    String    @db.Uuid
  round       Round     @relation(fields: [round_id], references: [id], onDelete: Cascade)
  question_id String
  position    Int
  state       String    @default("waiting")
  opened_at   DateTime? @db.Timestamptz(6)
  closed_at   DateTime? @db.Timestamptz(6)
  released_at DateTime? @db.Timestamptz(6)
  changed_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@id([round_id, question_id])
  @@unique([round_id, position])
  @@map("live_poll_question")
}

/// Presenter key of a seminar (3.4, ADR-008): opens the big screen of its live poll without Entra.
/// Only the sha256 of the 256-bit key is stored; the key is shown once, as a link. Valid from the
/// day before the seminar to the day after (Europe/Oslo, from the seminar's dates); one active key
/// per seminar (partial unique index): a new key revokes the old. Issue and revoke are in AuditLog.
model PresenterToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seminar_id String    @db.Uuid
  seminar    Seminar   @relation(fields: [seminar_id], references: [id], onDelete: Cascade)
  token_hash String    @unique
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  created_by String
  revoked_at DateTime? @db.Timestamptz(6)
  revoked_by String?

  @@index([seminar_id])
  @@map("presenter_token")
}

/// Hash-only history of replaced seminar links (3a, ADR-009): an old link, an invitation already
/// sent or a printed poster gets «Lenkja er bytt ut» instead of a plain 403.
model RevokedSeminarCode {
  code_hash  String   @id
  seminar_id String   @db.Uuid
  seminar    Seminar  @relation(fields: [seminar_id], references: [id], onDelete: Cascade)
  revoked_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([seminar_id])
  @@map("revoked_seminar_code")
}

/// Material of a seminar (3.3): a title and an http(s) link, no uploaded files (CHECKs). The
/// seminar page shows the list after the seminar has ended, to everyone who has its link.
model SeminarMaterial {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seminar_id String   @db.Uuid
  seminar    Seminar  @relation(fields: [seminar_id], references: [id], onDelete: Cascade)
  title      String
  url        String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  created_by String

  @@index([seminar_id])
  @@map("seminar_material")
}

/// The clients a seminar is for (3.1): the registration page offers them as companies.
model SeminarClient {
  seminar_id String  @db.Uuid
  seminar    Seminar @relation(fields: [seminar_id], references: [id], onDelete: Cascade)
  client_id  String  @db.Uuid
  client     Client  @relation(fields: [client_id], references: [id], onDelete: Restrict)

  @@id([seminar_id, client_id])
  @@index([client_id])
  @@map("seminar_client")
}

/// A person who registered for a seminar (3.1, ADR-017 class `contact`): personal data, read and
/// written only through modules/privacy (participants.ts, lint `varde/privacy-only-release`). Kept
/// while it has a registration or consent to invitations (decision of Oleksandr 16.10): the daily
/// job deletes a contact with neither, and marks the others a year after `last_confirmed_at` for
/// the yearly check. `email` is normalized (trimmed, lower case; CHECK), `company` is the chosen
/// client's name or the person's own text. The consent to this registration is on Registration;
/// `invite_consent_*` is the optional consent to invitations to later seminars (both or none,
/// CHECK). The public form creates a contact; of a known one it only adds a missing consent to
/// invitations. Name, company, client and the withdrawal of that consent are the admin's
/// (AuditLog); `last_confirmed_at` and the yearly mark change only by «Stadfest».
model Contact {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  email                  String         @unique
  client_id              String?        @db.Uuid
  client                 Client?        @relation(fields: [client_id], references: [id], onDelete: SetNull)
  company                String
  role_at_client         String?
  invite_consent_version String?
  invite_consent_at      DateTime?      @db.Timestamptz(6)
  created_at             DateTime       @default(now()) @db.Timestamptz(6)
  last_confirmed_at      DateTime       @default(now()) @db.Timestamptz(6)
  review_flagged_at      DateTime?      @db.Timestamptz(6)
  registrations          Registration[]

  @@index([review_flagged_at])
  @@map("contact")
}

/// One contact registered for one seminar (3.1, ADR-017 class `registration`): deleted by the
/// daily job 90 days after the seminar ends. One per seminar and contact, i.e. per e-mail.
/// `lang` ∈ {nn, en} (CHECK); the required consent (text version and time) of this registration.
/// Response never refers to it (ADR-021).
model Registration {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seminar_id      String   @db.Uuid
  seminar         Seminar  @relation(fields: [seminar_id], references: [id], onDelete: Cascade)
  contact_id      String   @db.Uuid
  contact         Contact  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  lang            String
  consent_version String
  consent_at      DateTime @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([seminar_id, contact_id])
  @@index([contact_id])
  @@map("registration")
}

/// Ledger of a participant deleted on request (3.1, ADR-017): the contact id and how many
/// registrations went with it, never the name or e-mail. Reapplied after a restore.
model ParticipantTombstone {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id    String          @db.Uuid
  request       DeletionRequest @relation(fields: [request_id], references: [id], onDelete: Restrict)
  contact_id    String          @db.Uuid
  registrations Int

  @@index([contact_id])
  @@map("participant_tombstone")
}

/// A measure Vardahei can propose, and the seminar topic it leads to (3.1, ARCHITECTURE §4).
model Action {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String              @unique
  description   String
  seminar_topic String
  created_at    DateTime            @default(now()) @db.Timestamptz(6)
  created_by    String
  rules         FindingRuleAction[]

  @@map("action")
}

/// FindingRule → Action (3.1, `action_id?` of ARCHITECTURE §4). Rule versions never change
/// (trigger finding_rule_immutable), so the link lives beside them, by rule key: every version of
/// the rule points to the same action, and changing the link writes no rule version.
model FindingRuleAction {
  rule_key  String   @id
  action_id String   @db.Uuid
  action    Action   @relation(fields: [action_id], references: [id], onDelete: Cascade)
  linked_at DateTime @default(now()) @db.Timestamptz(6)
  linked_by String

  @@index([action_id])
  @@map("finding_rule_action")
}

/// Working status of a finding (3.1, ARCHITECTURE §4); no row means `open`. `status` ∈ {open,
/// in_seminar, closed}; `in_seminar` needs a seminar and `open` has none (CHECKs). Finding rows
/// never change (2.5), so the status lives here; every change is also written to AuditLog.
model FindingStatus {
  finding_id String   @id @db.Uuid
  finding    Finding  @relation(fields: [finding_id], references: [id], onDelete: Cascade)
  status     String
  seminar_id String?  @db.Uuid
  seminar    Seminar? @relation(fields: [seminar_id], references: [id], onDelete: Restrict)
  changed_by String
  changed_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([seminar_id])
  @@map("finding_status")
}
