      "source": "./src/metrics/populations.ts",
      "default": "./dist/metrics/populations.js"
    },
    "./metrics/metric-definition": {
      "types": "./src/metrics/metric-definition.ts",
      "source": "./src/metrics/metric-definition.ts",
      "default": "./dist/metrics/metric-definition.js"
