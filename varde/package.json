{
  "name": "varde",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22 <26"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check": "pnpm -r lint && pnpm -r test && pnpm -r build",
    "format": "prettier --write .",
    "secrets": "bash tools/secrets/run.sh",
    "secrets:selfcheck": "bash tools/secrets/selfcheck.sh",
    "budget": "node tools/context-budget/check.mjs",
    "budget:selfcheck": "node tools/context-budget/check.mjs --selfcheck",
    "lint:privacy:selfcheck": "node tools/eslint-rules/selfcheck.mjs",
    "invariants:0a": "bash tools/invariants/run-0a.sh",
    "invariants:0b": "bash tools/invariants/run-0b.sh",
    "invariants:0c": "bash tools/invariants/run-0c.sh",
    "parity:fixtures": "node tools/parity/generate.mjs",
    "parity:golden": "node tools/parity/golden.mjs",
    "invariants:1a": "bash tools/invariants/run-1a.sh"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  }
}
